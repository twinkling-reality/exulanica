{
  "profile": "exulanica-gate.line-cases/v1",
  "maximum": 200,
  "about": "What a player's chat line becomes before its traveller says it. The Lua screen in exulanica_gate/lines.lua meets these in a check run; the repository's tests hold the table to Unicode's own character categories.",
  "cases": [
    {
      "case": "a plain line is said as typed",
      "text": "hello there",
      "said": "hello there"
    },
    {
      "case": "spaces at either end are trimmed",
      "text": "  hello  ",
      "said": "hello"
    },
    {
      "case": "a known player's name becomes someone, in any case, possessive too",
      "text": "hi Bob, is bob's sword here?",
      "names": [
        "Bob"
      ],
      "said": "hi someone, is someone's sword here?"
    },
    {
      "case": "a longer word holding a name is not a name",
      "text": "BobTheBuilder says hi",
      "names": [
        "Bob"
      ],
      "said": "BobTheBuilder says hi"
    },
    {
      "case": "names keep their hyphens and underscores",
      "text": "Ann-Lee_2 waved",
      "names": [
        "ann-lee_2"
      ],
      "said": "someone waved"
    },
    {
      "case": "200 characters are said",
      "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "said": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "case": "201 characters are refused",
      "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "refused": "line_too_long"
    },
    {
      "case": "letters beyond ASCII are text",
      "text": "café ünïcödé",
      "said": "café ünïcödé"
    },
    {
      "case": "an emoji is text",
      "text": "emoji 🙂 ok",
      "said": "emoji 🙂 ok"
    },
    {
      "case": "a no-break space inside is kept",
      "text": "nbsp inside",
      "said": "nbsp inside"
    },
    {
      "case": "a no-break space at the start is trimmed",
      "text": " leading nbsp",
      "said": "leading nbsp"
    },
    {
      "case": "a zero-width space is refused",
      "text": "zero​width",
      "refused": "line_has_hidden_characters"
    },
    {
      "case": "a right-to-left override is refused",
      "text": "right‮left",
      "refused": "line_has_hidden_characters"
    },
    {
      "case": "a tab is refused",
      "text": "tab\there",
      "refused": "line_has_hidden_characters"
    },
    {
      "case": "a line separator is refused",
      "text": "line sep",
      "refused": "line_has_hidden_characters"
    },
    {
      "case": "a private-use character is refused",
      "text": "private  use",
      "refused": "line_has_hidden_characters"
    },
    {
      "case": "a soft hyphen is refused",
      "text": "soft­hyphen",
      "refused": "line_has_hidden_characters"
    },
    {
      "case": "a byte order mark is refused",
      "text": "﻿mark",
      "refused": "line_has_hidden_characters"
    },
    {
      "case": "only spaces says nothing",
      "text": "   ",
      "refused": "line_empty"
    },
    {
