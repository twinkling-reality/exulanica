{
  "mcpServers": {
    "exulanica": {
      "command": "uvx",
      "args": [
        "--from",
        "exulanica-agent[mcp] @ git+https://github.com/twinkling-reality/exulanica@945501fb5ce7a8da68199706390054a9ceb64f35#subdirectory=bridges/agents",
        "exulanica-agent",
        "mcp"
      ],
      "env": {
        "EXULANICA_URL": "https://<the world's server>",
        "EXULANICA_AGENT_KEY_FILE": "<the absolute path of the key file the world's owner gave you>",
        "EXULANICA_AGENT_NAME": "Scout",
        "EXULANICA_AGENT_MAKER": "<your name or team>"
      }
    }
  }
}
