# Copy to .env and fill in. .env is gitignored and must never be committed.

# Nebius Token Factory. Get from https://tokenfactory.nebius.com/ -> Get API key
NEBIUS_API_KEY=

# PostgreSQL bootstrap and non-owner runtime roles. Percent-encode reserved URI characters in
# passwords because compose places them in connection URLs.
POSTGRES_PASSWORD=
EXULANICA_APP_ROLE_PASSWORD=
EXULANICA_EXECUTOR_ROLE_PASSWORD=
EXULANICA_ACCOUNT_ROLE_PASSWORD=
# The purge role destroys stored bytes and the backup role reads every row for a backup; only the
# maintenance service, and an operator's restore job, connect as them (docs/deployment.md 9).
EXULANICA_PURGE_ROLE_PASSWORD=
EXULANICA_BACKUP_ROLE_PASSWORD=

# The installation profile under deploy/profiles: single-host-server-only (the default, no
# reconstruction worker) or single-host (every component, linux/amd64, with `--profile
# reconstruction`). EXULANICA_BACKEND_EXTRAS selects the backend image's extras: leave empty for
# single-host-server-only, "--extra server --extra pose" for single-host.
EXULANICA_PROFILE=single-host-server-only
EXULANICA_BACKEND_EXTRAS=

# Host directories for backup sets and the stored-byte copy, and for withdrawal exports. Keep both
# apart from the database and media storage, and custody apart from backups.
EXULANICA_BACKUP_PATH=
EXULANICA_CUSTODY_PATH=

# The deployed identity installation facts report: the 40-character revision and sha256 digests.
EXULANICA_IMAGE_BACKEND=
EXULANICA_IMAGE_CLIENT=

# The client image's provenance: the bundle's tree digest and the toolchain that built it on the
# host (deploy/installation/client.Dockerfile). The revision is EXULANICA_CODE_REVISION below.
EXULANICA_CLIENT_TREE_SHA256=
EXULANICA_NODE_VERSION=
EXULANICA_PNPM_VERSION=

# Comma-separated UUIDs the dedicated derivative worker is authorised to drain.
EXULANICA_WORKSPACE_IDS=

# Optional account-owned workspace discovery. The URL must use the dedicated account role and
# resolve to the same database/schema as the application URL.
EXULANICA_ACCOUNT_DATABASE_URL=

# Optional Google OIDC account host configuration. Set all values together or leave all empty.
EXULANICA_GOOGLE_CLIENT_ID=
EXULANICA_GOOGLE_CLIENT_SECRET=
EXULANICA_GOOGLE_CALLBACK_URI=
EXULANICA_GOOGLE_RETURN_URIS=[]
EXULANICA_ACCOUNT_BROWSER_ORIGINS=[]

# Explicit account-wide society playback opt-in. Absent or false keeps it disabled.
EXULANICA_SOCIETY_CONTROL_WORKER=off
# Workspaces whose societies play without accounts, as a JSON array of ids, and the base wait in
# milliseconds (empty: the declared default). Who plays: "on", the API in threads; "process", the
# playback-worker service, started with `docker compose --profile playback up`.
EXULANICA_SOCIETY_CONTROL_WORKSPACES=
EXULANICA_SOCIETY_TICK_INTERVAL_MS=
EXULANICA_PLAYBACK_WORKER=on

# Production depth producer. Compose enables MoGe with the checkpoint models.manifest.json pins
# as local_roles.depth; set this only to select a device such as cuda, cpu, or mps.
EXULANICA_DEPTH_DEVICE=

# Exact provenance required by the separate reconstruction-scene worker. The image must be pinned
# by sha256 digest; a mutable tag is refused.
EXULANICA_CODE_REVISION=
EXULANICA_POSE_RUNTIME_IMAGE=

# JSON bearer-token directory used by the API. See docs/deployment.md; never commit a filled value.
# Every grant names its permissions, for example
# {"<token>":{"workspace_id":"<uuid>","actor":"<uuid>","permissions":["library.read"]}}.
# The vocabulary and what each permission reaches are in docs/security-floor.md.
EXULANICA_API_TOKENS=

# How a process holding NEBIUS_API_KEY spends: durable (admitted by the spending authority every
# process shares; docs/model-spending-contract.md) or process (within EXULANICA_BUDGET_USD alone,
# which a restart starts again). Required whenever NEBIUS_API_KEY is set. No default.
EXULANICA_SPENDING=
# The spending witness directory for durable spending: outside the database's backup domain and
# shared by every spending process on this host. Without it a durable process spends nothing under
# a witnessed authority.
EXULANICA_SPENDING_WITNESS_DIR=

# JSON array of origins the server may reach. Required whenever NEBIUS_API_KEY is set, and it must
# include the manifest's endpoint, for example ["https://api.tokenfactory.nebius.com"]. Add
# "https://tokenfactory.nebius.com" to run the catalog preflight. With Google sign-in configured it
# must also include "https://accounts.google.com", "https://oauth2.googleapis.com" and
# "https://www.googleapis.com". No default.
EXULANICA_EGRESS_ALLOWLIST=

# Tavily, the web source of reference notes (docs/reference-notes-contract.md), offered only to the
# workspaces EXULANICA_REFERENCE_WORKSPACES lists; web notes also need "https://api.tavily.com" in
# EXULANICA_EGRESS_ALLOWLIST. scripts/verify_web_lookup.py reads it for a one-off credential check.
# Get from https://tavily.com or the Nebius Builders Program
TAVILY_API_KEY=

# Reference notes. The worker runs in the API process unless set off; the JSON array of workspace
# ids that may ask for web notes is empty when absent. Notes from a person's own pictures are off
# unless EXULANICA_REFERENCE_PICTURES is on.
EXULANICA_REFERENCE_WORKER=
EXULANICA_REFERENCE_WORKSPACES=
EXULANICA_REFERENCE_PICTURES=

# Creatures drafted from a person's words (docs/things-contract.md). The worker runs in the API
# process unless set off; the JSON array of workspace ids whose people may draft creatures is empty
# when absent, as each draft spends the creature drafter's calls.
EXULANICA_CREATURE_WORKER=
EXULANICA_CREATURE_WORKSPACES=
