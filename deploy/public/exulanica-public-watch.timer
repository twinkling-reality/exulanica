# Every minute, from two minutes after boot, so the server's own `restart: unless-stopped` start has
# begun before the first check counts a failure.
[Unit]
Description=Exulanica public server health check, every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
