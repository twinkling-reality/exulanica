# The judge stack's public edge. deploy/judge/edge.yaml mounts this file and supplies the two
# values it reads from the environment.
#
# `tls` takes an email address, which asks a public certificate authority for a certificate
# through ACME, or the word `internal`, which issues from Caddy's own local authority for a
# rehearsal. Caddy redirects plain HTTP to HTTPS on its own.
#
# It proxies to `web`, never to `api`: `web` holds the single-origin `/api` prefix strip and the
# per-address write limit, and an edge that reached `api` directly would bypass both.
#
# Caddy's access log records request headers with Authorization and Cookie values redacted, so a
# judge's bearer token does not reach the log.
{
	admin off
}

{$EXULANICA_PUBLIC_HOST} {
	tls {$EXULANICA_TLS}
	# The same ceiling as the web proxy's client_max_body_size, 8 MiB.
	request_body {
		max_size 8MiB
	}
	# Caddy's own list of compressible types (caddy 2.11.4's default, written out because a match
	# replaces it), application/octet-stream (a world's texture sets, about a third of their size
	# compressed) and application/vnd.exulanica.owd (its baked tiles, about a fifth): both would
	# otherwise cross raw. A range request is answered uncompressed, as before.
	encode {
		zstd
		gzip
		match {
			header Content-Type application/atom+xml*
			header Content-Type application/eot*
			header Content-Type application/font*
			header Content-Type application/geo+json*
			header Content-Type application/graphql+json*
			header Content-Type application/graphql-response+json*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/ld+json*
			header Content-Type application/manifest+json*
			header Content-Type application/opentype*
			header Content-Type application/otf*
			header Content-Type application/rss+xml*
			header Content-Type application/truetype*
			header Content-Type application/ttf*
			header Content-Type application/vnd.api+json*
			header Content-Type application/vnd.ms-fontobject*
			header Content-Type application/wasm*
			header Content-Type application/x-httpd-cgi*
			header Content-Type application/x-javascript*
			header Content-Type application/x-opentype*
			header Content-Type application/x-otf*
			header Content-Type application/x-perl*
			header Content-Type application/x-protobuf*
			header Content-Type application/x-ttf*
			header Content-Type application/xhtml+xml*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
			header Content-Type image/vnd.microsoft.icon*
			header Content-Type image/x-icon*
			header Content-Type multipart/bag*
			header Content-Type multipart/mixed*
			header Content-Type text/*
			header Content-Type application/octet-stream*
			header Content-Type application/vnd.exulanica.owd*
		}
	}
	reverse_proxy web:8080 {
		transport http {
			# Answering a question runs a model call; the web proxy allows 300 s for the same reason.
			read_timeout 300s
		}
	}
	log {
		output stdout
		format json
	}
	# The edge's own refusals, in the problem shape the API and the web proxy answer with
	# ({"code", "detail"}), with the web proxy's codes and Retry-After. handle_errors runs only for
	# errors the edge raises itself; an answer from the web proxy or the API passes through as sent.
	handle_errors 413 {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"code":"body_too_large","detail":"the request body is larger than the 8388608 bytes this installation accepts","limit_bytes":8388608}` 413
	}
	handle_errors 502 {
		header Content-Type application/json
		header Cache-Control no-store
		header Retry-After 5
		respond `{"code":"upstream_unavailable","detail":"the installation's web proxy closed the connection or could not be reached; whether the request ran is not known, so send it again after 5 seconds only if repeating it is safe","retry_after_seconds":5}` 502
	}
	handle_errors 504 {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"code":"upstream_timeout","detail":"the installation's web proxy did not answer within 300 seconds; whether the request ran is not known"}` 504
	}
}
