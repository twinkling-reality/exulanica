# The judge web image's context, an allowlist as the root `.dockerignore` is: the web workspace
# without its installed or built output, the files the bundle imports from outside `web/`, and the
# world workspace the build patches into the app.
# Never a `.env`.
*
!web
web/**/node_modules
web/**/dist
!assets/catalogs
!assets/colour/srgb8-linear16.v1.json
!assets/characters
!assets/owned-world
!assets/style-packs/settings/setting-rules.v1.json
!assets/style-packs/town-look-roles.v1.json
!assets/textures/manifest.json
!assets/textures/blobs
!exulanica/world/interaction-policy-registry.v1.json
!tools/previews/world-workspace
**/.env
**/.env.*
