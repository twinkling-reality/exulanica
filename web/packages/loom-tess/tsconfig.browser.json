{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // lib.dom for Web Crypto, and no @types/node, so a `node:` import reachable from the preview
    // entry is a compile error rather than a bundler surprise.
    "lib": ["ES2022", "DOM"],
    "types": [],
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/browser.tsbuildinfo"
  },
  "include": ["src/browser/**/*.ts"],
  "references": [{ "path": "./tsconfig.core.json" }]
}
