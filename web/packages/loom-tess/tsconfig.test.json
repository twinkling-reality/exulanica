{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Tests run under vitest in Node, and exercise all three entries through their references.
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/test.tsbuildinfo"
  },
  "include": ["test/**/*.ts"],
  "references": [
    { "path": "./tsconfig.core.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.browser.json" }
  ]
}
