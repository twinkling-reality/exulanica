node_modules/
dist/
*.tsbuildinfo
fixtures/
# ...except the .opm pin, which is 2 KB and is the only thing tying the Python writer to the
# decoder that reads it. The rule above is for scene-synth's generated bake-off fixtures,
# which are tens of megabytes and are rebuilt by `pnpm synth`.
!packages/atlas-react/test/fixtures/
!packages/atlas-react/test/fixtures/*.opm
# ...and except the world-objects contract fixture, which is hand written rather than generated:
# it is 4 KB of wire shapes that `world-objects-api.test.ts` parses, and losing it would leave the
# client's tests reading a file that is not in the repository.
!packages/graph-client/test/fixtures/
!packages/graph-client/test/fixtures/*.json
# ...and the three reviewed CC0 meshes the same contract publishes. The backend generates these
# deterministically and deliberately commits no binary; `web/` commits binary fixtures, and the
# renderer's container validator is only worth having if it is run against the actual reviewed
# bytes. `scene-objects.test.ts` asserts their digests against world-objects.json, so a generator
# change fails here loudly instead of drifting.
!packages/graph-client/test/fixtures/*.glb
bakeoff-results/
