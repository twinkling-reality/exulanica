{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "description": "Which of the session's decisions the file holds: those a minute took up, or all.",
      "properties": {
        "decisions": {
          "enum": [
            "consumed",
            "all"
          ],
          "title": "Decisions",
          "type": "string"
        }
      },
      "required": [
        "decisions"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "Selected evidence, not a prompt, hidden reasoning, or executable engine receipt.",
      "properties": {
        "binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Sha256",
          "type": "string"
        },
        "chosen_option_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9:._/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Chosen Option Id"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Elapsed Ms"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "applied",
            "refused",
            "not-applied"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "readable": {
          "anyOf": [
            {
              "$ref": "#/$defs/Readable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Reason Code",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Receipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "source_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Record Sha256",
          "type": "string"
        },
        "thing_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Thing Id",
          "type": "string"
        },
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "thing_id",
        "tick",
        "binding_sha256",
        "source_record_sha256",
        "observation_sha256",
        "options",
        "chosen_option_id",
        "outcome",
        "reason_code",
        "elapsed_ms",
        "input_tokens",
        "output_tokens"
      ],
      "title": "Decision",
      "type": "object"
    },
    "ModelBinding": {
      "additionalProperties": false,
      "properties": {
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Model Id",
          "type": "string"
        },
        "model_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Manifest Sha256",
          "type": "string"
        },
        "provider": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Revision",
          "type": "string"
        },
        "role": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Role",
          "type": "string"
        },
        "thing_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Thing Id",
          "type": "string"
        }
      },
      "required": [
        "thing_id",
        "role",
        "contract_sha256",
        "model_manifest_sha256",
        "provider",
        "model_id",
        "revision"
      ],
      "title": "ModelBinding",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Action",
          "type": "string"
        },
        "option_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Option Id",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9:._/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Id"
        }
      },
      "required": [
        "option_id",
        "action",
        "target_id"
      ],
      "title": "Option",
      "type": "object"
    },
    "Readable": {
      "additionalProperties": false,
      "description": "What a source decision record itself stores, made readable. Opt-in at capture.\n\nThe situation is the text the model was shown, rebuilt from the record's own context;\nlabels, choice and line are as recorded. Nothing comes from outside the record.",
      "properties": {
        "choice": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Choice"
        },
        "consumed_tick": {
          "minimum": 0,
          "title": "Consumed Tick",
          "type": "integer"
        },
        "cost_known": {
          "title": "Cost Known",
          "type": "boolean"
        },
        "cost_usd": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,6}(\\.[0-9]{1,12})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Usd"
        },
        "disposition": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Disposition",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line"
        },
        "options": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Reason",
          "type": "string"
        },
        "served_model_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9:._/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Served Model Id"
        },
        "situation": {
          "maxLength": 20000,
          "title": "Situation",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "unavailable",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "situation",
        "options",
        "choice",
        "line",
        "status",
        "reason",
        "consumed_tick",
        "disposition",
        "served_model_id",
        "cost_usd",
        "cost_known"
      ],
      "title": "Readable",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "description": "What the source receipt and its minute recorded, as codes and numbers: no words.\n\n`status` is the receipt's (did the model give a usable answer the engine accepted);\n`disposition` is what a minute did with an accepted answer, or null when none has.",
      "properties": {
        "consumed_tick": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Consumed Tick"
        },
        "cost_known": {
          "title": "Cost Known",
          "type": "boolean"
        },
        "cost_usd": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,6}(\\.[0-9]{1,12})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Usd"
        },
        "disposition": {
          "anyOf": [
            {
              "enum": [
                "applied",
                "rejected",
                "superseded",
                "stale"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disposition"
        },
        "disposition_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[a-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Disposition Reason"
        },
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-z0-9_.:-]+$",
          "title": "Reason",
          "type": "string"
        },
        "served_model_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9:._/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Served Model Id"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "unavailable",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "disposition",
        "disposition_reason",
        "consumed_tick",
        "served_model_id",
        "cost_usd",
        "cost_known"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Sha256",
          "type": "string"
        },
        "version_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "Version Id",
          "type": "string"
        },
        "world_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9:._/-]+$",
          "title": "World Id",
          "type": "string"
        }
      },
      "required": [
        "world_id",
        "version_id",
        "snapshot_id",
        "state_sha256",
        "snapshot_sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "$id": "exulanica.world-project-evidence/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One session's decision records, kept beside the checkpoint rather than inside it.\n\nEvidence is what happened while models played; it is not part of the world definition. Each\nrecord binds to a model assignment carried in this same file, so it stays verifiable after\nthe checkpoint's assignment changes. A file has its own digest.",
  "properties": {
    "captured_at": {
      "anyOf": [
        {
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-5][0-9]Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Captured At"
    },
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Decisions",
      "type": "array"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelBinding"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "profile": {
      "const": "exulanica.world-project-evidence/v1",
      "title": "Profile",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9:._/-]+$",
      "title": "Project Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9:._/-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    }
  },
  "required": [
    "profile",
    "project_id",
    "session_id",
    "source",
    "models",
    "decisions"
  ],
  "title": "Evidence",
  "type": "object"
}
