    "judged": [
      {
        "id": "no-violation",
        "rule": "In every world and judged seed the checker names no violation of any rule: no flying position outside the volume or the kind's band; no landing, take-off or perch off its perch's column, and no perching flyer off its perch's point; no move longer than the kind's top speed allows in a step, the move into every episode and between windows included; no point of any move in a solid cell other than its perch object's own, while it moves along that perch's column; no move bringing a body, a box as wide as its kind's span, into a part of any object other than that; no perch holding two flyers; every episode's first step with every flyer perching at home."
      },
      {
        "id": "every-flyer-home",
        "rule": "At every episode's last step every flyer is perching at its home perch, in every world and judged seed, and every window names exactly the flyers the checker finds not home."
      },
      {
        "id": "exact-replay",
        "rule": "Every window computed twice has one digest, in every world and seed."
      },
      {
        "id": "twenty-four-flyers-in-a-frame",
        "rule": "With the small square and seven more trees drawn on the release build, 24 flyers served, main-thread work per frame at the 95th percentile stays under one 60 Hz frame (16,667 us). If it does not, max_flyers is lowered to the largest population measured that does, and the record says so."
      }
    ],
    "module": {
      "episode_steps": 3000,
      "id": "exulanica-movement/flight/v1",
      "max_cells": 262144,
      "max_flyers": 24,
      "max_parts": 2048,
      "step_ms": 100
    },
    "profile": "exulanica.flight-bounds/v2/preregistration",
    "question": "With routes home over free cells, air grown by half the widest span, perch columns that are their own object's alone and the page's handling of refusals, does the flight keep every flyer's point in its volume and band, its body clear of every object's parts and its moves out of every solid cell it may not use, bring every flyer home at every episode's end, replay exactly, and draw 24 flyers within one 60 Hz frame of main-thread work on the release build?",
    "reported": [
      {
        "id": "guard-interventions",
        "what": "Per world, the steps the guard refused what steering proposed. No target."
      },
      {
        "id": "request-cost",
        "what": "Process time, median of 5, inside quiet-slot behind the idle gate, for eight trees and the cluttered world (24 flyers each): composing the air and perches, one cold window from the step before an episode ends, one cold window from an episode's first step, and one window resumed from the one before."
      },
      {
        "id": "request-blocking",
        "what": "On the release server, GET /healthz every 20 ms alone and beside one cold window from the step before an episode ends, five times: how long the window took, and the health answers' median, 95th percentile and slowest, alone and beside it."
      },
      {
        "id": "frame-time",
        "what": "Main-thread work per frame, rAF intervals and callback lag over 60 s, release build on slot 6 from a fresh database, each arm in its own headless Chrome, inside quiet-slot then gpu-slot with the idle gate. Arms: the square with its flight refused, the square (3 flyers), the square and seven more trees with the flight refused, and with it (24)."
      }
    ],
    "run": {
      "checker": "exulanica.movement.flight_checks.check_windows over each run's windows in order: every window, the move joining it to the last, the move into every episode",
      "command": "uv run python scripts/measure_flight_bounds.py --seeds judged-2 --minutes 30 --out FILE",
      "minutes_per_seed": 30,
      "window_steps": 600
    },
